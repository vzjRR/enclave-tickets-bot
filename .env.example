# Discord application credentials. Create the app at
# https://discord.com/developers/applications and keep this file's real
# counterpart (.env) out of version control.
DISCORD_TOKEN=your_bot_token
CLIENT_ID=your_application_client_id

# Optional: register commands to one guild instantly while testing.
# Leave empty to register globally (can take up to an hour to propagate).
GUILD_ID=

# Automatic ticket maintenance sweep. Minimum 5.
TICKET_REFRESH_INTERVAL_MINUTES=30

# Message Content is a PRIVILEGED intent. Requesting it before enabling it in
# the Developer Portal (Bot > Privileged Gateway Intents) makes login fail.
# Transcripts only contain message text when this is true.
ENABLE_MESSAGE_CONTENT=false

