# Discord application credentials. Create the app at
# https://discord.com/developers/applications and keep this file's real
# counterpart (.env) out of version control. chmod 600 it on a server.
DISCORD_TOKEN=your_bot_token
CLIENT_ID=your_application_client_id

# The one guild this deployment serves. Commands register there instantly
# (leave empty to register globally, which works but can take up to an hour to
# propagate), and the running bot ignores every other guild it is in.
#
# That second part matters if you run more than one instance of this bot on the
# same token -- a demo beside production, say. Without GUILD_ID set, BOTH
# processes answer BOTH servers' interactions, duplicating tickets and DMs.
#
# Run `npm run guilds` to list the servers the bot is in with their ids.
GUILD_ID=

# --- Deployment targets ----------------------------------------------------
# Set these to adopt channels and a role that already exist on the server,
# instead of letting /quick-setup create its own. Leave empty on a fresh
# server and the bot creates everything itself.

# Existing channel the ticket panel is posted in.
PANEL_CHANNEL_ID=

# Existing channel closed tickets are archived to. Should be staff-only.
LOG_CHANNEL_ID=

# Existing role that gets access to every ticket.
STAFF_ROLE_ID=

# New ticket categories are placed directly above this category.
ANCHOR_CATEGORY_ID=

# --- Branding --------------------------------------------------------------

# Shown under the bot's name in the member list.
BOT_ACTIVITY=ENCLAVE RP TICKETS SYSTEM

# Second half of the footer on every embed: "<bot name> | <tagline>".
BRAND_TAGLINE=Discord Manager

# Image on the "Ticket Closed" card. Defaults to the bot's own avatar.
CLOSED_CARD_THUMBNAIL=

# --- Notifications ---------------------------------------------------------

# Staff are always mentioned in the ticket channel. To DM them as well, the bot
# needs to read who holds the staff role, which requires the privileged Server
# Members intent. Enable it at Developer Portal > Bot > Privileged Gateway
# Intents FIRST -- requesting it here without enabling it there makes login
# fail. With this off, staff are still mentioned in the channel.
ENABLE_GUILD_MEMBERS=false
STAFF_DM_ON_NEW_TICKET=true

# Upper bound on DMs sent per ticket, so a large staff role cannot trigger a
# burst that hits Discord's rate limits.
STAFF_DM_LIMIT=25

# Whether the member who opened a ticket receives their own transcript. The
# ticket log is staff-only and Discord cannot show a member just their own
# entry in it, so this is how they get a copy of their record.
TRANSCRIPT_SEND_TO_OWNER=true

# --- Behaviour -------------------------------------------------------------

# Automatic ticket maintenance sweep. Minimum 5. The claim-response timeout
# below is only checked on this cadence, so lower it if you want that
# deadline enforced more precisely.
TICKET_REFRESH_INTERVAL_MINUTES=30

# Message Content is a PRIVILEGED intent, with the same caveat as above.
# Transcripts only contain message text when this is true; without it every
# line reads [no text content]. Enable it in the Developer Portal FIRST --
# setting this true while the portal toggle is off makes login fail outright.
ENABLE_MESSAGE_CONTENT=false

# Maximum tickets a non-admin member (anyone without Administrator, including
# ticket staff) can open per day. Resets at 00:00 Oman time (UTC+4).
TICKET_DAILY_LIMIT=3

# Hours a member has to reply after their ticket is claimed before it is
# closed automatically.
CLAIM_RESPONSE_TIMEOUT_HOURS=12

# --- Streamer Application ---------------------------------------------------
# A separate panel from the main ticket one -- never added to it, never
# touched by /quick-setup. Leave STREAMER_APPLICATION_CATEGORY_ID empty to
# disable the feature; with it set, run /streamer-setup once in whichever
# channel should host the panel.

# Existing category the applicant's ticket is created under.
STREAMER_APPLICATION_CATEGORY_ID=

# Role granted automatically when staff approve an application.
STREAMER_ROLE_ID=

# Role(s) that can review/approve/reject applications, in addition to
# Administrator and Manage Server. Comma-separate for more than one (e.g.
# STREAMER_REVIEW_ROLE_ID=111,222). Defaults to STAFF_ROLE_ID above if unset.
STREAMER_REVIEW_ROLE_ID=

# Channel the staff-facing application card (with Approve/Reject/Request
# Info buttons) is posted in. Defaults to LOG_CHANNEL_ID if unset.
STREAMER_REVIEW_CHANNEL_ID=
