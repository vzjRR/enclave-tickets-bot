# Discord application credentials. Create the app at
# https://discord.com/developers/applications and keep this file's real
# counterpart (.env) out of version control. chmod 600 it on a server.
DISCORD_TOKEN=your_bot_token
CLIENT_ID=your_application_client_id

# Register commands to one guild instantly. Leave empty to register globally,
# which works but can take up to an hour to propagate.
# Run `npm run guilds` to list the servers the bot is in with their ids.
GUILD_ID=

# --- Deployment targets ----------------------------------------------------
# Set these to adopt channels and a role that already exist on the server,
# instead of letting /quick-setup create its own. Leave empty on a fresh
# server and the bot creates everything itself.

# Existing channel the ticket panel is posted in.
PANEL_CHANNEL_ID=

# Existing channel closed tickets are archived to. Should be staff-only.
LOG_CHANNEL_ID=

# Existing role that gets access to every ticket.
STAFF_ROLE_ID=

# New ticket categories are placed directly above this category.
ANCHOR_CATEGORY_ID=

# Which ticket lifecycles to run. "new" is the modern flow (hidden categories,
# DM notifications, archive-and-delete on close). "classic" reproduces the
# original AbuFaisal flow (rename to closed-<number>, keep the channel).
# Production usually wants just "new"; the demo server runs both to compare.
ENABLED_FLOWS=new,classic

# --- Behaviour -------------------------------------------------------------

# Shown under the bot's name in the member list.
BOT_ACTIVITY=ENCLAVE RP TICKETS SYSTEM

# Automatic ticket maintenance sweep. Minimum 5.
TICKET_REFRESH_INTERVAL_MINUTES=30

# Message Content is a PRIVILEGED intent. Requesting it before enabling it in
# the Developer Portal (Bot > Privileged Gateway Intents) makes login fail.
# Transcripts only contain message text when this is true.
ENABLE_MESSAGE_CONTENT=false

# Classic-flow transcripts are DMed to the member as well as the staff member
# who claimed the ticket. Set false to send them to staff only.
TRANSCRIPT_SEND_TO_OWNER=true

# Image shown on the "Ticket Closed" card. Defaults to the bot's own avatar.
CLOSED_CARD_THUMBNAIL=
