[Unit]
Description=Enclave Tickets - Discord ticket bot
Documentation=https://github.com/vzjRR/enclave-tickets-bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=discordbots
Group=discordbots
WorkingDirectory=/opt/enclave-tickets
ExecStart=/usr/bin/node src/index.js

# Credentials come from .env in WorkingDirectory, read by dotenv. Deliberately
# not an EnvironmentFile: systemd parses quoting differently to dotenv, so
# having one source avoids the two disagreeing about a token.

# The bot recovers from a crash on its own; the process exits on an uncaught
# exception precisely so this can restart it with clean state.
Restart=always
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=10

# It only needs to read its own directory and write data/.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/opt/enclave-tickets/data

StandardOutput=journal
StandardError=journal
SyslogIdentifier=enclave-tickets

[Install]
WantedBy=multi-user.target
